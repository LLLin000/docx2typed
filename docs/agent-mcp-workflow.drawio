<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Agent-facing DOCX Workflow">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="lane-agent" value="Agent 面 · 只需理解 5 步" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="330" height="980" as="geometry" />
        </mxCell>
        <mxCell id="lane-engine" value="MCP / 引擎面 · 自动保证 invariant" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="390" y="20" width="520" height="980" as="geometry" />
        </mxCell>
        <mxCell id="lane-state" value="状态 / 产物面 · D / C / H 分开" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="950" y="20" width="590" height="980" as="geometry" />
        </mxCell>

        <mxCell id="a1" value="1 · OPEN&#xa;workdir_open&#xa;打开或重新绑定文档" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="lane-agent">
          <mxGeometry x="55" y="70" width="220" height="75" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="2 · READ / PLAN&#xa;search · list · get · diff&#xa;只读，不产生文档变更" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="lane-agent">
          <mxGeometry x="55" y="230" width="220" height="75" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="3 · EDIT DRAFT&#xa;replace / batch / insert / delete&#xa;同一批逻辑修改优先 batch_edit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="lane-agent">
          <mxGeometry x="55" y="390" width="220" height="85" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="4 · REVIEW / COMMIT&#xa;diff_preview → review → commit_sync&#xa;有问题就回到第 3 步" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="lane-agent">
          <mxGeometry x="55" y="550" width="220" height="85" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="5 · DELIVER&#xa;build_docx → verify_output&#xa;验证后才交付" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="lane-agent">
          <mxGeometry x="55" y="710" width="220" height="75" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="任何失败结果&#xa;读取 recovery.action&#xa;refresh / retry / resolve-review / ask-user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lane-agent">
          <mxGeometry x="55" y="870" width="220" height="75" as="geometry" />
        </mxCell>

        <mxCell id="m1" value="连接级 bootstrap&#xa;initialize → tools/list&#xa;每个 connection 一次，不是每个任务一次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-engine">
          <mxGeometry x="55" y="70" width="410" height="75" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="Session boundary&#xa;workdir_open 验证并绑定文档&#xa;允许 rebind，不让旧 session 卡住" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane-engine">
          <mxGeometry x="55" y="230" width="410" height="75" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="自动安全 gate&#xa;preflight · writer lock · CAS&#xa;Agent 不必手工先调 preflight" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane-engine">
          <mxGeometry x="55" y="390" width="410" height="75" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="Mutation / review gate&#xa;idempotency ledger · evidence · commit&#xa;canonical mutation 会使旧 verify 失效" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane-engine">
          <mxGeometry x="55" y="550" width="410" height="85" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="Delivery gate&#xa;build 只接受 clean canonical&#xa;verify 是最后一步；失败返回 structured recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane-engine">
          <mxGeometry x="55" y="710" width="410" height="75" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="引擎内部，不要求 Agent 编排&#xa;transaction · generation · journal · fingerprints&#xa;写操作自动触发 scoped / global preflight；review_preflight 仍可主动规划" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="lane-engine">
          <mxGeometry x="55" y="870" width="410" height="75" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="连接 / 文档句柄&#xa;session scope&#xa;未来可扩展为 document_handle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="lane-state">
          <mxGeometry x="50" y="70" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="Read result&#xa;结构、段落、差异&#xa;不改变 D / C / H" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="lane-state">
          <mxGeometry x="50" y="230" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="Draft state H&#xa;edit.md · edit.state.json&#xa;dirty / clean / conflict" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="lane-state">
          <mxGeometry x="50" y="390" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="Document state D(n+1)&#xa;canonical identity = generation&#xa;不等同于单个 typed.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="lane-state">
          <mxGeometry x="50" y="550" width="230" height="85" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="Collaboration state C / H&#xa;review events · patches · snapshots&#xa;与 document generation 分开" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="lane-state">
          <mxGeometry x="310" y="550" width="230" height="85" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="Verified artifact&#xa;output.docx + verify evidence&#xa;后续 canonical mutation 会使它失效" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="lane-state">
          <mxGeometry x="50" y="710" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="当前约束 / 可演进点&#xa;1. omitted operation_id 会生成新 ID；host/adapter 应保留返回 ID 才能在丢包后安全重放&#xa;2. 段落编辑只阻塞相交的 queued human patch；commit / decide / table 等 canonical-wide 操作仍全局阻塞&#xa;3. build_preview 仍是未来的 ephemeral preview，不是交付物&#xa;4. 普通 decide_all 用新 generation；明确 fork 才新 workdir" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="lane-state">
          <mxGeometry x="50" y="870" width="490" height="100" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="m1" target="m2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="m2" target="m3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="m3" target="m4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="m4" target="m5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="a1" target="m1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="a2" target="m2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="a3" target="m3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="a4" target="m4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="a5" target="m5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="m1" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="m2" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="m3" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="m4" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" parent="1" source="m5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="legend" value="主线：Agent 只编排 5 步；MCP 把 preflight / CAS / idempotency / journal / verify 下沉到引擎。&#xa;H = draft，D = canonical document generation，C = collaboration state，Verified = 可交付物。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="1030" width="1520" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
