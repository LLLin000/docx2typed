    },
    "docx2typed-result-1": {
      "type": "object",
      "required": [
        "schema",
        "operation",
        "outcome",
        "data",
        "diagnostics",
        "evidence",
        "engine"
      ],
      "properties": {
        "schema": {
          "const": "docx2typed-result-1"
        },
        "outcome": {
          "enum": [
            "success",
            "failure",
            "partial"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "docx2typed-run-evidence-1"
          }
        }
      }
    },
    "docx2typed-run-evidence-1": {
      "type": "object",
      "required": [
        "schema",
        "operation",
        "outcome",
        "kind",
        "operation_id",
        "payload",
        "payload_sha256",
        "provenance"
      ],
      "properties": {
        "schema": {
          "const": "docx2typed-run-evidence-1"
        },
        "outcome": {
          "enum": [
            "success",
            "failure",
            "partial"
          ]
        },
        "kind": {
          "enum": [
            "mutation",
            "build",
            "verify",
            "partial-decision"
          ]
        },
        "payload": {
          "type": "object",
          "description": "Canonical semantic payload: input/output hashes, engine and contract identity, checks, decision ids. Never document bodies, comment text, raw XML, secrets, or absolute paths."
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provenance": {
          "type": "object",
          "description": "Time and run identity; excluded from semantic equivalence."
        }
      }
    }
  },
