{
  "tasks": [
    {
      "id": "t15-table-cell-text",
      "capability": "text.edit.cell",
      "prompt": "table cell 文本修改，表格结构不变",
      "source": "corpus/release/table.docx",
      "steps": [
        {
          "op": "extract",
          "expect": "ok"
        },
        {
          "op": "edit_sync",
          "edits": [
            {
              "paragraph": "T0.R1.C1.P0",
              "old": "PVA",
              "new": "PLBA"
            }
          ],
          "expect": "ok"
        },
        {
          "op": "build",
          "expect": "ok"
        },
        {
          "op": "verify",
          "expect": "ok"
        }
      ],
      "oracles": {
        "positive": [
          {
            "kind": "text_count",
            "text": "PLBA",
            "count": 1
          }
        ],
        "negative": [
          {
            "kind": "text_count",
            "text": "PVA",
            "count": 1
          }
        ],
        "fidelity": [
          {
            "kind": "verify_pass"
          },
          {
            "kind": "row_col_counts",
            "rows": 7,
            "cells": 19
          },
          {
            "kind": "office_open"
          }
        ]
      }
    },
