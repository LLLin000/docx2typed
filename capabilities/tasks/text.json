    {
      "id": "t04-edit-cjk-word",
      "capability": "text.edit.body",
      "prompt": "把正文中的“20 mg”改成“25 mg”",
      "source": "corpus/release/plain.docx",
      "steps": [
        {
          "op": "extract",
          "expect": "ok"
        },
        {
          "op": "edit_sync",
          "edits": [
            {
              "paragraph": "P0",
              "old": "20 mg",
              "new": "25 mg"
            }
          ],
          "expect": "ok"
        },
        {
          "op": "build",
          "expect": "ok"
        },
        {
          "op": "verify",
          "expect": "ok"
        }
      ],
      "oracles": {
        "positive": [
          {
            "kind": "text_count",
            "text": "25 mg",
            "count": 1
          }
        ],
        "negative": [
          {
            "kind": "text_count",
            "text": "20 mg",
            "count": 0
          }
        ],
        "fidelity": [
          {
            "kind": "verify_pass"
          },
          {
            "kind": "parts_unchanged",
            "except": [
              "word/document.xml"
            ]
          },
          {
            "kind": "office_open"
          }
        ]
      }
