      "id": "t08-cross-region-rejected",
      "capability": "text.edit.region",
      "prompt": "故意跨两个 style region 替换，必须拒绝",
      "source": "corpus/release/styled.docx",
      "steps": [
        {
          "op": "extract",
          "expect": "ok"
        },
        {
          "op": "mcp_open",
          "expect": "ok"
        },
        {
          "op": "mcp_replace",
          "paragraph": "P2",
          "old": "第一区域第二区域",
          "new": "跨区域改写",
          "expect": "fail",
          "error_contains": "region"
